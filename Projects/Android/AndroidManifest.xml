<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	package="com.drbeef.lambda1vr"
	android:versionCode="39"
	android:versionName="1.7.4"
	android:installLocation="auto" >

	<!-- Tell the system this app requires OpenGL ES 3.1. -->
	<uses-feature android:glEsVersion="0x00030002" android:required="true"/>

	<uses-feature android:name="android.hardware.vr.headtracking" android:version="1"
		android:required="true" />
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />


	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
		tools:ignore="AllFilesAccessPolicy,ScopedStorage" />
	<uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

	<queries>
		<provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
		<intent>
			<action android:name="org.khronos.openxr.OpenXRRuntimeService" />
		</intent>
	</queries>


	<application android:allowBackup="false"
		android:icon="@drawable/ic_lambda1vr"
		android:label="@string/lambda1vr"
		android:extractNativeLibs="true"	>

		<meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only"/>

		<!-- META QUEST -->
		<meta-data android:name="com.oculus.supportedDevices" android:value="quest|quest2|questpro|quest3|quest3s"/>
		<!--meta-data android:name="com.oculus.ossplash" android:value="true"/-->
		<!-- Set Dual Core mode for Quest 2/Pro -->
		<meta-data android:name="com.oculus.dualcorecpuset" android:value="true" />
		<!-- Enabling CPU and GPU level trading: -1 = -1 level to gpu, +1 level to cpu -->
		<!-- CPU needs all the power it can get!! -->
		<meta-data android:name="com.oculus.trade_cpu_for_gpu_amount" android:value="-1" />
		<meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

		<!-- PICO XR -->
		<meta-data android:name="pvr.app.type" android:value="vr" />
		<!-- the PICO headsets the app is offered on. PICO 4 Ultra advertises
		     codename "pico_4_ultra"; we keep the 4 / Neo3 / G3 family as
		     optional so the same APK can ride the platform. -->
		<meta-data android:name="pvr.supportedDevices" android:value="pico_4_ultra|pico_4|pico_neo3|pico_g3" />
		<!-- Controller-only input. pvr.app.inputType=controller is what PICO OS
		     reads to decide the runtime is a controller-only app; combined with
		     the absence of a handtracking feature it suppresses the HAND_DIALOG
		     overlay (com.picovr.systemext/.HandDialogActivity) that otherwise
		     covers the game and absorbs controller input on every cold launch.
		     We do NOT declare a handtracking feature at all - even with
		     required=false that flips the system into hybrid input mode.
		     oculus.software.requires_controller is a Meta-only hint that PICO OS
		     ignores, so it is omitted too. -->
		<meta-data android:name="pvr.app.inputType" android:value="controller" />
		<!-- Belt-and-braces: a few PICO OS builds (notably the 5.x runtime on
		     the Pico 4 Ultra) probe pvr.app.handtrackingSupport before they
		     honour inputType. Setting it to 0 keeps the systemext out of our
		     launch path even if a future OS update re-enables the hybrid probe.
		     Harmless on older builds that ignore the key. -->
		<meta-data android:name="pvr.app.handtrackingSupport" android:value="0" />

		<activity
			android:exported="true"
			android:name="com.drbeef.lambda1vr.GLES3JNIActivity"
			android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
			android:launchMode="singleTask"
			android:screenOrientation="landscape"
			android:resizeableActivity="false"
			android:excludeFromRecents="false"
			android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<!-- the game activity is the immersive one: the Khronos loader
				     and the PICO OS launcher look for these categories to bring
				     the app up in VR instead of as a flat 2D panel. -->
				<category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
				<category android:name="com.oculus.intent.category.VR" />
				<category android:name="com.picovr.intent.category.VR" />
			</intent-filter>
		</activity>
	</application>
</manifest>
